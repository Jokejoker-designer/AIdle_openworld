{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidle.local/schemas/environment_module_record-1.1.json",
  "title": "AIdle Environment Module Registry Record",
  "type": "object",
  "required": ["schema_version", "module_id", "class", "world_profiles", "style_fit", "blend_source", "source_sha256", "collection_name", "dimensions_m", "materials", "lod_policy", "provenance"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "module_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,95}$"},
    "class": {"enum": ["TERRAIN", "ARCHITECTURE", "NATURE", "PROP", "LANDMARK", "LIGHTING", "INTERACTION_HINT"]},
    "world_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cozy_cyber_pixel", "tiny_diorama", "solarpunk_haven", "arcane_clockwork", "spirit_valley", "surrealism_canvas", "oceanpunk_abyss"]}},
    "style_fit": {"enum": ["NATIVE", "ADAPTED", "ANOMALY"]},
    "blend_source": {"type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[A-Za-z0-9_. /\\\\-]+\\.blend$"},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "collection_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,95}$"},
    "dimensions_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 512}},
    "sockets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,95}$"}},
    "materials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,95}$"}},
    "lod_policy": {"enum": ["NONE", "LOD0_ONLY", "LOD0_LOD1", "LOD0_LOD1_LOD2", "HLOD_ELIGIBLE"]},
    "collision_hint": {"type": ["string", "null"], "maxLength": 120},
    "provenance": {
      "type": "object",
      "required": ["author", "license_id", "source_kind", "registry_version"],
      "properties": {
        "author": {"type": "string", "minLength": 1, "maxLength": 120},
        "license_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "source_kind": {"enum": ["PROJECT_AUTHORED", "APPROVED_OPEN_SOURCE", "GENERATED_QUARANTINE"]},
        "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
