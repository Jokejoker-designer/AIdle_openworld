{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidle.local/schemas/environment_scene_manifest-1.1.json",
  "title": "AIdle Exported Environment Scene Manifest",
  "type": "object",
  "required": ["schema_version", "job_id", "request_fingerprint", "world_profile", "registry_version", "seed", "coordinate_system", "output_zone", "modules", "build_plot", "camera_markers", "navigation_hints", "collision_hints", "provenance", "validation_sha256"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "job_id": {"type": "string", "pattern": "^BLD-[A-F0-9]{12}$"},
    "request_fingerprint": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "world_profile": {"enum": ["cozy_cyber_pixel", "tiny_diorama", "solarpunk_haven", "arcane_clockwork", "spirit_valley", "surrealism_canvas", "oceanpunk_abyss"]},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "coordinate_system": {"const": "BLENDER_Z_UP_METERS"},
    "output_zone": {"const": "generated_quarantine"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["instance_id", "module_id", "artifact_path", "artifact_sha256", "transform", "content_phase", "manifestation_order"],
        "properties": {
          "instance_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,95}$"},
          "module_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,95}$"},
          "artifact_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[A-Za-z0-9_. /\\\\-]+\\.glb$"},
          "artifact_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "transform": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number"}},
          "content_phase": {"enum": ["TERRAIN", "PATH", "SHELTER", "NATURE", "INTERACTIVE", "LIGHTING", "LANDMARK"]},
          "manifestation_order": {"type": "integer", "minimum": 0, "maximum": 4096}
        },
        "additionalProperties": false
      }
    },
    "build_plot": {"type": "object", "required": ["center", "size_m"], "properties": {"center": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "size_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}}, "additionalProperties": false},
    "camera_markers": {"type": "array", "items": {"type": "object", "required": ["id", "position", "target"], "properties": {"id": {"type": "string"}, "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "target": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}, "additionalProperties": false}},
    "navigation_hints": {"type": "array", "items": {"type": "object", "required": ["kind", "points"], "properties": {"kind": {"enum": ["WALKABLE", "BLOCKED", "PORTAL", "SLOPE"]}, "points": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}}, "additionalProperties": false}},
    "collision_hints": {"type": "array", "items": {"type": "object", "required": ["instance_id", "hint"], "properties": {"instance_id": {"type": "string"}, "hint": {"enum": ["NONE", "BOX", "CAPSULE", "CONVEX", "STATIC_MESH_REVIEW"]}}, "additionalProperties": false}},
    "provenance": {"type": "object", "required": ["template_id", "template_sha256", "operation_allowlist_version", "blender_version"], "properties": {"template_id": {"type": "string"}, "template_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "operation_allowlist_version": {"type": "string"}, "blender_version": {"const": "5.2.0"}}, "additionalProperties": false},
    "validation_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "additionalProperties": false
}
