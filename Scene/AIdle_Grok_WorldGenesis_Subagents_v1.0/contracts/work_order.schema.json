{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIdle World Genesis Work Order",
  "type": "object",
  "required": [
    "work_order_id",
    "world_number",
    "world_profile",
    "phase_slice",
    "objective",
    "state",
    "authority",
    "allowed_files",
    "acceptance_tests",
    "required_evidence"
  ],
  "properties": {
    "work_order_id": {
      "type": "string"
    },
    "world_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "world_profile": {
      "type": "string"
    },
    "phase_slice": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "TODO",
        "BLOCKED",
        "READY",
        "CLAIMED",
        "IN_PROGRESS",
        "REVIEW_REQUESTED",
        "VERIFIED",
        "CHANGES_REQUESTED",
        "HITL_REQUIRED",
        "ACCEPTED"
      ]
    },
    "coverage": {
      "type": "string",
      "enum": [
        "NONE",
        "PARTIAL",
        "COMPLETE"
      ]
    },
    "authority": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_children": {
      "type": "integer",
      "maximum": 5
    },
    "grandchildren_forbidden": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
