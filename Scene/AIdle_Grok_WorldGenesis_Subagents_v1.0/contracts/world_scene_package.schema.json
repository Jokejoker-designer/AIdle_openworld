{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIdle World Scene Package",
  "type": "object",
  "required": [
    "world_number",
    "world_profile",
    "starter_realm",
    "ux_flow",
    "controls",
    "characters",
    "runtime",
    "world_contract",
    "asset_pipeline",
    "acceptance_criteria"
  ],
  "properties": {
    "world_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "world_profile": {
      "type": "string"
    },
    "starter_realm": {
      "type": "object"
    },
    "ux_flow": {
      "type": "object"
    },
    "controls": {
      "type": "object"
    },
    "characters": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "world_contract": {
      "type": "object"
    },
    "asset_pipeline": {
      "type": "object"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
