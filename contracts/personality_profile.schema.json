{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidle.local/contracts/personality-profile/1.0.0",
  "title": "AIdle Companion Personality Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "companion_id", "base_traits", "adaptive_traits", "adaptation_policy", "privacy_mode", "revision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "companion_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "base_traits": {"$ref": "#/$defs/traits"},
    "adaptive_traits": {"$ref": "#/$defs/traits"},
    "adaptation_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "max_delta_per_turn", "max_delta_per_day", "max_distance_from_base", "minimum_observations", "minimum_independent_sessions", "minimum_confidence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_delta_per_turn": {"type": "number", "minimum": 0, "maximum": 0.005},
        "max_delta_per_day": {"type": "number", "minimum": 0, "maximum": 0.03},
        "max_distance_from_base": {"type": "number", "minimum": 0, "maximum": 0.25},
        "minimum_observations": {"type": "integer", "minimum": 3, "maximum": 100},
        "minimum_independent_sessions": {"type": "integer", "minimum": 3, "maximum": 30},
        "minimum_confidence": {"type": "number", "minimum": 0.65, "maximum": 1},
        "locked_traits": {"type": "array", "uniqueItems": true, "items": {"enum": ["warmth", "curiosity", "calmness", "humor", "supportive_guardianship", "precision", "brevity", "initiative"]}}
      }
    },
    "privacy_mode": {"enum": ["session_only", "local_durable", "account_sync"]},
    "revision": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "traits": {
      "type": "object", "additionalProperties": false,
      "required": ["warmth", "curiosity", "calmness", "humor", "supportive_guardianship", "precision", "brevity", "initiative"],
      "properties": {
        "warmth": {"type": "number", "minimum": 0, "maximum": 1},
        "curiosity": {"type": "number", "minimum": 0, "maximum": 1},
        "calmness": {"type": "number", "minimum": 0, "maximum": 1},
        "humor": {"type": "number", "minimum": 0, "maximum": 1},
        "supportive_guardianship": {"type": "number", "minimum": 0, "maximum": 0.7},
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "brevity": {"type": "number", "minimum": 0, "maximum": 1},
        "initiative": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
