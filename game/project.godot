; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AIdle Openworld"
config/description="AIdle Openworld – pinned Godot 4.3 2.5D shell (fixed-angle camera)"
config/version="0.1.0-core"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AIdleConstants="*res://scripts/core/constants.gd"
EventBus="*res://autoload/event_bus.gd"
SettingsManager="*res://autoload/settings_manager.gd"
ArtStyleManager="*res://autoload/art_style_manager.gd"
ProvenanceLogger="*res://autoload/provenance_logger.gd"
ModuleRegistry="*res://autoload/module_registry.gd"
GameManager="*res://autoload/game_manager.gd"
ControlContextRouter="*res://autoload/control_context_router.gd"
ControlAccessibilitySettings="*res://autoload/control_accessibility_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

