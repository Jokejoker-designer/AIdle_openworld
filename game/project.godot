; Engine configuration file.
; AIdle Openworld – Agent-Core 2.5D shell (Godot 4.3 pinned).
; ARCHITECTURE_LOCK: fixed-angle camera; no free 3D camera in MVP.
; Reality Hierarchy locked – do not rename WorldRoot spaces without blueprint bump.

config_version=5

[application]

config/name="AIdle Openworld"
config/description="AIdle Openworld – pinned Godot 4.3 2.5D shell (fixed-angle camera)"
config/version="0.1.0-core"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AIdleConstants="*res://scripts/core/constants.gd"
EventBus="*res://autoload/event_bus.gd"
SettingsManager="*res://autoload/settings_manager.gd"
ArtStyleManager="*res://autoload/art_style_manager.gd"
ProvenanceLogger="*res://autoload/provenance_logger.gd"
ModuleRegistry="*res://autoload/module_registry.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

