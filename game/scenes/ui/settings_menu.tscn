[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_menu.gd" id="1_settings"]

[node name="SettingsMenu" type="CanvasLayer"]
layer = 60
process_mode = 3
script = ExtResource("1_settings")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.1, 0.65)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(360, 280)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Settings"
horizontal_alignment = 1

[node name="MasterLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Master Volume"

[node name="MasterVolume" type="HSlider" parent="Center/Panel/VBox"]
layout_mode = 2
max_value = 100.0
value = 80.0

[node name="Fullscreen" type="CheckBox" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Fullscreen"

[node name="VSync" type="CheckBox" parent="Center/Panel/VBox"]
layout_mode = 2
text = "VSync"

[node name="DebugOverlay" type="CheckBox" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Debug Overlay (F3)"

[node name="Back" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Back"

[connection signal="value_changed" from="Center/Panel/VBox/MasterVolume" to="." method="_on_master_changed"]
[connection signal="toggled" from="Center/Panel/VBox/Fullscreen" to="." method="_on_fullscreen_toggled"]
[connection signal="toggled" from="Center/Panel/VBox/VSync" to="." method="_on_vsync_toggled"]
[connection signal="toggled" from="Center/Panel/VBox/DebugOverlay" to="." method="_on_debug_toggled"]
[connection signal="pressed" from="Center/Panel/VBox/Back" to="." method="_on_back_pressed"]
