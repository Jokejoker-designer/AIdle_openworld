{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidle.local/contracts/block_dna_adapt_001/build_graph.schema.json",
  "title": "Block-DNA Adapt 001 Strict Build Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "build_graph_id",
    "world_profile",
    "expected_world_revision",
    "idempotency_key",
    "bounds",
    "nodes",
    "edges",
    "generators",
    "world_rules",
    "manifestation",
    "validation",
    "rollback",
    "payload_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "block_dna_adapt_001/1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_\\-]+$"
    },
    "build_graph_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_]+$"
    },
    "world_profile": {
      "type": "string",
      "enum": [
        "cozy_cyber_pixel",
        "tiny_diorama",
        "solarpunk_haven",
        "arcane_clockwork",
        "spirit_valley",
        "surrealism_canvas",
        "oceanpunk_abyss"
      ]
    },
    "expected_world_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "current_world_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_\\-]+$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -128,
              "maximum": 128
            },
            "y": {
              "type": "number",
              "minimum": -128,
              "maximum": 128
            },
            "z": {
              "type": "number",
              "minimum": -64,
              "maximum": 64
            }
          }
        },
        "max": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -128,
              "maximum": 128
            },
            "y": {
              "type": "number",
              "minimum": -128,
              "maximum": 128
            },
            "z": {
              "type": "number",
              "minimum": -64,
              "maximum": 64
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "module_id",
          "transform",
          "occupancy_cell",
          "material_slot",
          "p1e_material_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "elevation",
              "rotation_deg",
              "scale"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -128,
                "maximum": 128
              },
              "y": {
                "type": "number",
                "minimum": -128,
                "maximum": 128
              },
              "elevation": {
                "type": "number",
                "minimum": -64,
                "maximum": 64
              },
              "rotation_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 4
              }
            }
          },
          "occupancy_cell": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cx",
              "cy",
              "cz"
            ],
            "properties": {
              "cx": {
                "type": "integer",
                "minimum": -256,
                "maximum": 256
              },
              "cy": {
                "type": "integer",
                "minimum": -256,
                "maximum": 256
              },
              "cz": {
                "type": "integer",
                "minimum": -128,
                "maximum": 128
              }
            }
          },
          "material_slot": {
            "type": "string",
            "enum": [
              "body",
              "secondary",
              "accent",
              "structure",
              "trim",
              "glass",
              "ground",
              "emission",
              "roof",
              "wood",
              "stone",
              "water",
              "leaf",
              "metal",
              "soil",
              "door"
            ]
          },
          "p1e_material_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^MAT_[A-Za-z0-9_]+$"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from_node",
          "from_socket",
          "from_polarity",
          "to_node",
          "to_socket",
          "to_polarity"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_node": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_socket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_polarity": {
            "type": "string",
            "enum": [
              "input",
              "output",
              "peer"
            ]
          },
          "to_node": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "to_socket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "to_polarity": {
            "type": "string",
            "enum": [
              "input",
              "output",
              "peer"
            ]
          },
          "adapter_normalization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "generators": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generator_id",
          "seed"
        ],
        "properties": {
          "generator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9_]+$"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 16,
            "properties": {
              "bounds_width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 128
              },
              "bounds_depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 128
              }
            }
          }
        }
      }
    },
    "world_rules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9_]+$"
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 8
          }
        }
      }
    },
    "manifestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "requires_confirmation",
        "presentation_duration_seconds"
      ],
      "properties": {
        "stages": {
          "const": [
            "wireframe",
            "hologram",
            "materializing",
            "complete"
          ]
        },
        "requires_confirmation": {
          "const": true
        },
        "presentation_duration_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collision",
        "occupancy",
        "sockets",
        "cycle",
        "snap"
      ],
      "properties": {
        "collision": {
          "const": true
        },
        "occupancy": {
          "const": true
        },
        "sockets": {
          "const": true
        },
        "cycle": {
          "const": true
        },
        "snap": {
          "const": true
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "mode"
      ],
      "properties": {
        "allowed": {
          "const": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "COMPENSATING_MUTATION",
            "SNAPSHOT_RESTORE"
          ]
        }
      }
    },
    "adapter_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "confirmation_state",
        "preview_required"
      ],
      "properties": {
        "kind": {
          "const": "structured_world_prompt_proposal"
        },
        "confirmation_state": {
          "const": "pending"
        },
        "preview_required": {
          "const": true
        }
      }
    },
    "payload_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
