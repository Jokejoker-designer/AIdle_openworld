{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidle.local/contracts/block_dna_adapt_001/build_recipe.schema.json",
  "title": "Block-DNA Adapt 001 Strict Build Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "recipe_type",
    "world_profile",
    "root_module_id",
    "idempotency_key",
    "instances",
    "connections",
    "material_overrides",
    "behavior_bindings",
    "validation",
    "outputs",
    "payload_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "block_dna_adapt_001/1.0"
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_]+$"
    },
    "recipe_type": {
      "type": "string",
      "enum": [
        "MODULE_CLUSTER",
        "CHARACTER",
        "PROP",
        "STRUCTURE",
        "TERRAIN_PATCH"
      ]
    },
    "world_profile": {
      "type": "string",
      "enum": [
        "cozy_cyber_pixel",
        "tiny_diorama",
        "solarpunk_haven",
        "arcane_clockwork",
        "spirit_valley",
        "surrealism_canvas",
        "oceanpunk_abyss"
      ]
    },
    "root_module_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_\\-]+$"
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "module_id",
          "transform"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "rotation_deg",
              "scale"
            ],
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -128,
                  "maximum": 128
                }
              },
              "rotation_deg": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                }
              },
              "scale": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 4
                }
              }
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 16,
            "properties": {
              "tint": {
                "type": "string",
                "maxLength": 32
              },
              "variant": {
                "type": "string",
                "maxLength": 32
              },
              "lod": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "label": {
                "type": "string",
                "maxLength": 64
              },
              "note": {
                "type": "string",
                "maxLength": 128
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              "enabled": {
                "type": "boolean"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 128
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 64
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 128
              },
              "style_hint": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "from_instance",
          "from_socket",
          "from_polarity",
          "to_instance",
          "to_socket",
          "to_polarity"
        ],
        "properties": {
          "connection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_socket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_polarity": {
            "type": "string",
            "enum": [
              "input",
              "output",
              "peer"
            ]
          },
          "to_instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "to_socket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "to_polarity": {
            "type": "string",
            "enum": [
              "input",
              "output",
              "peer"
            ]
          },
          "adapter_normalization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    },
    "material_overrides": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "slot",
          "p1e_material_id"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(\\*|[a-z0-9_]+)$"
          },
          "slot": {
            "type": "string",
            "enum": [
              "body",
              "secondary",
              "accent",
              "structure",
              "trim",
              "glass",
              "ground",
              "emission",
              "roof",
              "wood",
              "stone",
              "water",
              "leaf",
              "metal",
              "soil",
              "door"
            ]
          },
          "p1e_material_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^MAT_[A-Za-z0-9_]+$"
          }
        }
      }
    },
    "behavior_bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "behavior_id"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "behavior_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9_]+$"
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 8
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_sockets",
        "check_materials",
        "check_occupancy"
      ],
      "properties": {
        "check_sockets": {
          "const": true
        },
        "check_materials": {
          "const": true
        },
        "check_occupancy": {
          "const": true
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_only"
      ],
      "properties": {
        "proposal_only": {
          "const": true
        },
        "scene_manifest": {
          "type": "boolean"
        },
        "asset_request_on_missing": {
          "const": true
        }
      }
    },
    "payload_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
