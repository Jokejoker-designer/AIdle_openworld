  "conflict_rules": [
    {
      "rule_id": "C1B-CF-01",
      "statement": "One physical input must not dispatch actions from multiple active contexts in the same frame.",
      "severity": true,
      "physical_example": "R"
    },
    {
      "rule_id": "C1B-CF-02",
      "statement": "Most-specific context wins for modified wheel events (zoom vs tool vs elevation vs scale).",
      "severity": true,
      "physical_example": "MouseWheel"
    },
    {
      "rule_id": "C1B-CF-03",
      "statement": "Left mouse button must not simultaneously drive locomotion and tool use.",
      "severity": true,
      "physical_example": "MouseLeft"
    },
    {
      "rule_id": "C1B-CF-04",
      "statement": "UI text focus consumes character keys; world actions must not double-fire.",
      "severity": true,
      "physical_example": "Slash"
    },
    {
      "rule_id": "C1B-CF-05",
      "statement": "jump must not silently dual-bind with ui_accept.",
      "severity": true,
      "physical_example": "Space"
    },
    {
      "rule_id": "C1B-CF-06",
      "statement": "Conflict matrix is machine-checkable against catalog plus active context.",
      "severity": true
    }
  ],
