{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aidle:motion_primitives.schema.json",
  "title": "AIdle motion primitive contract",
  "type": "object",
  "required": ["catalog_version", "primitive_kinds", "authored_base_requirements", "clip_bindings"],
  "additionalProperties": true,
  "properties": {
    "catalog_version": { "type": "string" },
    "generated_from": { "type": "object" },
    "purpose": { "type": "string" },
    "authority_note": { "type": "string" },
    "summary": { "type": "object" },
    "primitive_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "implementation", "requires_authored_base"],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["DIRECTION_MIRROR","LOCOMOTION_CYCLE","PROCEDURAL_AIM","BINARY_TOGGLE","REACH_MANIPULATE","GROWTH_SHAPE","IDLE_VARIANT","SIGNATURE_UNIQUE","VFX_PARAMETER"]
          },
          "implementation": {
            "type": "string",
            "enum": ["BLEND_1D","PROCEDURAL_LOOKAT","PLAYBACK_DIRECTION","IK_REACH","BLENDSHAPE_SCALAR","ADDITIVE_ACCENT","UNIQUE_CLIP","EMISSION_SCALAR"]
          },
          "runtime_parameter": { "type": ["string", "null"] },
          "parameter_range": { "type": ["array", "null"] },
          "requires_authored_base": { "type": "array", "items": { "type": "string" } },
          "authoring_cost": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "authored_base_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skeleton_id", "reusable_base_poses", "unique_clips_to_author"],
        "additionalProperties": true,
        "properties": {
          "skeleton_id": { "type": "string" },
          "reusable_base_poses": { "type": "array", "items": { "type": "string" } },
          "unique_clips_to_author": { "type": "array", "items": { "type": "string" } },
          "authoring_summary": { "type": "object" }
        }
      }
    },
    "clip_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["animation_set_id", "skeleton_id", "clip_id", "kind", "params"],
        "additionalProperties": true,
        "properties": {
          "animation_set_id": { "type": "string" },
          "skeleton_id": { "type": "string" },
          "clip_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["DIRECTION_MIRROR","LOCOMOTION_CYCLE","PROCEDURAL_AIM","BINARY_TOGGLE","REACH_MANIPULATE","GROWTH_SHAPE","IDLE_VARIANT","SIGNATURE_UNIQUE","VFX_PARAMETER"]
          },
          "params": { "type": "object" },
          "must_author": { "type": "boolean" }
        }
      }
    }
  }
}
