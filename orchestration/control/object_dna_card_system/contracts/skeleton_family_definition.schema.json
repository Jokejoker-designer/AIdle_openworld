{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidle.local/object-dna-card-system/contracts/skeleton_family_definition.schema.json",
  "title": "AIdle Skeleton Family Definition (Object DNA §5 content for vNext L1)",
  "description": "Registry entry shape for a skeleton family. Intended to be ingested as dna_catalog_entry entry_kind=SKELETON during vNext V1 migration. Not a parallel catalog SSOT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "category",
    "display_name",
    "applications",
    "required_animation_clips",
    "aliases",
    "lifecycle_status",
    "vnext_entry_kind",
    "accepted",
    "self_accept"
  ],
  "properties": {
    "schema_version": {
      "const": "object_dna_card_system/skeleton_family_definition/0.1"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$",
      "description": "Canonical ID from Object DNA SOURCE §5 (e.g. robot_biped_small_v1)."
    },
    "category": {
      "enum": [
        "humanoid",
        "quadruped",
        "bird_flying",
        "fish_aquatic",
        "robot_mechanism",
        "plant",
        "vehicle"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required_animation_clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "Clip IDs required by SOURCE §5 for this family category (design target lists)."
    },
    "optional_animation_clips": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "aliases": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_\\-]+$"
      },
      "description": "Alternate IDs already in production or Tier3 (e.g. skel_small_biped_robot_v1)."
    },
    "tier3_catalog_ref": {
      "type": ["string", "null"],
      "description": "Optional path or id in foundation skeleton_families.json if known."
    },
    "bone_graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "UNSPECIFIED",
            "PLACEHOLDER_ONLY",
            "PRODUCTION_HIERARCHY_EXISTS",
            "FULLY_SPECIFIED"
          ]
        },
        "production_bone_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "hierarchy_ref": {
          "type": ["string", "null"],
          "description": "Repo-relative path to production hierarchy JSON if any."
        },
        "required_semantic_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "contact_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "entity_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "CHARACTER",
          "CREATURE",
          "PROP",
          "VEHICLE",
          "BUILDING",
          "PLANT",
          "SYSTEM"
        ]
      },
      "description": "Maps to universal_entity_recipe entity_kind values."
    },
    "lifecycle_status": {
      "enum": [
        "DESIGN_ONLY",
        "AUTHORING_REQUIRED",
        "QUARANTINED",
        "VERIFIED",
        "APPROVED",
        "DEPRECATED"
      ],
      "description": "Aligned with dna_catalog_entry.schema.json lifecycle_status."
    },
    "vnext_entry_kind": {
      "const": "SKELETON",
      "description": "Must compile into dna_catalog_entry entry_kind SKELETON at V1."
    },
    "source_doc_section": {
      "type": "string",
      "maxLength": 64
    },
    "accepted": {
      "const": false
    },
    "self_accept": {
      "const": false
    }
  }
}
